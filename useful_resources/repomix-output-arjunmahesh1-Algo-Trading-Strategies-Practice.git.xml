   "source": [
    "# Pair Trading USD.AUD v. USD.CAD Using the Johansen Eigenvector"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import statsmodels.api as sm\n",
    "from statsmodels.tsa.vector_ar.vecm import coint_johansen"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "USDCADdf = pd.read_csv('data/USDCAD_history.csv', skiprows=1)\n",
    "USDCADdf.columns = ['Date', 'Close', 'Volume', 'Open', 'High', 'Low']\n",
    "USDCADdf['Date'] = pd.to_datetime(USDCADdf['Date'], errors='coerce')\n",
    "USDCADdf['Close'] = pd.to_numeric(USDCADdf['Close'], errors='coerce')\n",
    "\n",
    "AUDUSDdf = pd.read_csv('data/AUDUSD_history.csv', skiprows=1)\n",
    "AUDUSDdf.columns = ['Date', 'Close', 'Volume', 'Open', 'High', 'Low']\n",
    "AUDUSDdf['Date'] = pd.to_datetime(AUDUSDdf['Date'], errors='coerce')\n",
    "AUDUSDdf['Close'] = pd.to_numeric(AUDUSDdf['Close'], errors='coerce')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Logic and Strategy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "cad = 1.0 / USDCADdf['Close']\n",
    "aud = AUDUSDdf['Close']\n",
    "y = pd.concat([aud, cad], axis=1, keys=['AUDUSD', 'CADUSD'])\n",
    "y.dropna(inplace=True)\n",
    "\n",
    "trainlen = 250\n",
    "lookback = 20\n",
    "\n",
    "hedgeRatio = pd.DataFrame(index=y.index, columns=y.columns)\n",
    "numUnits = pd.Series(index=y.index)\n",
    "\n",
    "for t in range(trainlen, len(y)):\n",
    "    y_windowed = y.iloc[t-trainlen:t]\n",
    "    res = coint_johansen(y_windowed, 0, 1)\n",
    "    \n",
    "    hedgeRatio_current = pd.Series(res.evec[:, 0], index=y.columns)\n",
    "    yport = (y.iloc[t-lookback+1:t] * hedgeRatio_current).sum(axis=1)\n",
    "    ma = yport.mean()\n",
    "    mstd = yport.std()\n",
    "    zScore = (yport.iloc[-1] - ma) / mstd\n",
    "    \n",
    "    hedgeRatio.iloc[t] = hedgeRatio_current\n",
    "    numUnits.iloc[t] = -(yport.iloc[-1] - ma) / mstd\n",
    "\n",
    "positions = numUnits.shift() * hedgeRatio.shift() * y\n",
    "positions.dropna(inplace=True)\n",
    "pnl = (positions.shift(1) * (y - y.shift(1)) / y.shift(1)).sum(axis=1)\n",
    "ret = pnl / (positions.shift(1).abs().sum(axis=1) + 1e-10)"
   ]
  },
