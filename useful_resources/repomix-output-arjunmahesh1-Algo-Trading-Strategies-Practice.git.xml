   "source": [
    "# Buy/Short-on-Gap Strategy"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "DOWdf = pd.read_csv('data/DOW_hourly_history.csv', header=0)\n",
    "DOWdf['Date'] = pd.to_datetime(DOWdf['Date'], errors='coerce')\n",
    "DOWdf.set_index('Date', inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Calculations & Buy-on-Gap Strategy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "stocks = ['DIA','GS.N','NKE.N','CSCO.OQ','JPM.N','DIS.N','INTC.OQ','DOW.N','MRK.N','CVX.N','AXP.N','VZ.N','HD.N','WBA.OQ','MCD.N','UNH.N','KO.N','JNJ.N','MSFT.OQ','HON.OQ','CRM.N','PG.N','IBM.N','MMM.N','AAPL.OQ','WMT.N','CAT.N','AMGN.OQ','V.N','TRV.N','BA.N']\n",
    "\n",
    "daily_first_hour = DOWdf.groupby(DOWdf.index.date).first()\n",
    "daily_last_hour = DOWdf.groupby(DOWdf.index.date).last()\n",
    "\n",
    "portfolio = pd.DataFrame(index=daily_first_hour.index, columns=stocks)\n",
    "portfolio_returns = pd.DataFrame(index=daily_first_hour.index, columns=stocks)\n",
    "\n",
    "for stock in stocks:\n",
    "    daily_first_hour[f'{stock}_PrevLow'] = daily_first_hour[stock].shift(1)\n",
    "\n",
    "    daily_first_hour[f'{stock}_GapReturn'] = (daily_first_hour[stock] - daily_first_hour[f'{stock}_PrevLow']) / daily_first_hour[f'{stock}_PrevLow']\n",
    "\n",
    "    std_dev = daily_first_hour[f'{stock}_GapReturn'].rolling(window=90).std()\n",
    "\n",
    "    gapped_down = daily_first_hour[f'{stock}_GapReturn'] < -std_dev\n",
    "    \n",
    "    daily_first_hour[f'{stock}_20D_MA'] = daily_first_hour[stock].rolling(window=20).mean()\n",
    "\n",
    "    above_MA = daily_first_hour[stock] > daily_first_hour[f'{stock}_20D_MA']\n",
    "\n",
    "    buy_decision = gapped_down & above_MA\n",
    "    portfolio[stock] = buy_decision.astype(int)\n",
    "\n",
    "    portfolio_returns[stock] = portfolio[stock] * (daily_last_hour[stock] - daily_first_hour[stock]) / daily_first_hour[stock]\n",
    "\n",
    "portfolio_returns['Total_Return'] = portfolio_returns.sum(axis=1)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Buy-on-Gap Cumulative Returns Visualization + Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "APR: 190.50%\n",
      "Sharpe Ratio: 3.05\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "portfolio_returns['Cumulative_Return'] = portfolio_returns['Total_Return'].cumsum()\n",
    "\n",
    "# APR\n",
    "trading_periods = len(portfolio_returns)\n",
    "years = trading_periods / 1638  \n",
    "APR = (portfolio_returns['Cumulative_Return'].iloc[-1] + 1) ** (1/years) - 1\n",
    "\n",
    "# Sharpe\n",
    "mean_daily_return = portfolio_returns['Total_Return'].mean()\n",
    "std_dev_return = portfolio_returns['Total_Return'].std()\n",
    "sharpe_ratio = np.sqrt(1638) * (mean_daily_return / std_dev_return)\n",
    "\n",
    "print(f\"APR: {APR*100:.2f}%\")\n",
    "print(f\"Sharpe Ratio: {sharpe_ratio:.2f}\")\n",
    "\n",
    "portfolio_returns['Cumulative_Return'].plot(figsize=(10, 6), title=\"Cumulative Returns of Buy-on-Gap Strategy\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Cumulative Returns\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
