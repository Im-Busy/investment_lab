      "source": [
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "# Assume pair_trading_final is defined and selected_stocks is a list of best correlated pairs\n",
        "\n",
        "# Initialize DataFrame for total portfolio tracking with dates as index\n",
        "total_portfolio_tracking = pd.DataFrame()\n",
        "\n",
        "# Loop through each selected stock pair\n",
        "for pair in selected_stocks:\n",
        "    # Assuming pair_trading_final returns daily_portfolio_values DataFrame with a 'Portfolio Value' column\n",
        "    total_return, daily_portfolio_values, portfolio_fig, final_portfolio_value, trading_history, trading_fig = pair_trading_final(pair[0], pair[1], '2023-02-01', '2023-12-01', '1d')\n",
        "\n",
        "    # Combine daily values into the total portfolio tracking DataFrame\n",
        "    if total_portfolio_tracking.empty:\n",
        "        total_portfolio_tracking = daily_portfolio_values[['Portfolio Value']].rename(columns={'Portfolio Value': pair})\n",
        "    else:\n",
        "        total_portfolio_tracking = total_portfolio_tracking.join(daily_portfolio_values[['Portfolio Value']].rename(columns={'Portfolio Value': pair}), how='outer')\n",
        "\n",
        "# Sum across rows to get the total portfolio value for each day\n",
        "total_portfolio_tracking['Total Portfolio Value'] = total_portfolio_tracking.sum(axis=1)\n",
        "\n",
        "# Filter out days with zero total portfolio value (optional, based on your needs)\n",
        "total_portfolio_tracking = total_portfolio_tracking[total_portfolio_tracking['Total Portfolio Value'] > 0]\n",
        "\n",
        "# Now total_portfolio_tracking will have outliers removed from the 'Total Portfolio Value' column.\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-05-01'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-06-01'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-08-07'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-02-20'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-05-29'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-06-19'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-07-04'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-09-04'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-11-23'), errors='ignore')\n",
        "total_portfolio_tracking = total_portfolio_tracking.drop(pd.Timestamp('2023-04-10'), errors='ignore')\n",
        "\n",
        "\n",
        "\n",
        "# Plot the total portfolio value over time\n",
        "fig = go.Figure()\n",
        "fig.add_trace(\n",
        "    go.Scatter(\n",
        "        x=total_portfolio_tracking.index,\n",
        "        y=total_portfolio_tracking['Total Portfolio Value'],\n",
        "        mode='lines',\n",
        "        name='Total Portfolio Value'\n",
        "    )\n",
        ")\n",
        "fig.update_layout(title='Total Portfolio Value Over Time', xaxis_title='Date', yaxis_title='Value', template='plotly_white')\n",
        "fig.show()\n",
        "\n",
        "# Calculate and print the final total portfolio value and return\n",
        "final_total_portfolio_value = total_portfolio_tracking['Total Portfolio Value'].iloc[-1]\n",
        "total_portfolio_return = (final_total_portfolio_value - 60000) / 60000 * 100\n",
        "print(f\"Final total portfolio value: {final_total_portfolio_value}\")\n",
        "print(f\"Total portfolio return: {total_portfolio_return:.2f}%\")\n"
      ],
