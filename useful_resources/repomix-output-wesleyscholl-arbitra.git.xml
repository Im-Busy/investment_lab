    def test_kelly_negative_avg_win(self):
        """Test Kelly criterion with negative average win."""
        win_rate = Decimal("0.60")
        avg_win = Decimal("-50")
        avg_loss = Decimal("100")

        kelly = KellyCriterion.calculate(win_rate, avg_win, avg_loss)

