        "    print(f'Vol is : {compute_vol(daily_portfolio_values)}')\n",
        "    print(f'MDD is : {(compute_dd(daily_portfolio_values)).min()}')\n",
        "    print(f'Sharp Ratio is : {compute_sharpe_ratio(daily_portfolio_values)}')\n"
