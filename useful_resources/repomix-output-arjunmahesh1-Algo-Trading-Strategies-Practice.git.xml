    "plt.title('Stationarity of Residuals of Linear Regression between EWA and EWC')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('EWC-hedgeRatio*EWA')\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
