        "        dtw_distance = dtw_distance_calculation(ts1, ts2)\n",
        "        dtw_distances.append(dtw_distance)\n",
        "\n",
        "    # Calculate threshold\n",
        "    dtw_threshold = calculate_dtw_threshold(dtw_distances)\n",
