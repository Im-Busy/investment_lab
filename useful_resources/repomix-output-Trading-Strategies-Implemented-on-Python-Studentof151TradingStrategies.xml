        "import numpy as np\n",
        "\n",
        "def monte_carlo_var(initial_investment, expected_return, volatility, confidence_level, num_simulations, simulation_years):\n",
        "    # Set simulation parameters\n",
        "    np.random.seed(42)\n",
        "    daily_returns = np.random.normal(expected_return / 252, volatility / np.sqrt(252), (simulation_years * 252, num_simulations))\n",
        "\n",
        "    # Calculate portfolio values for each simulation\n",
        "    portfolio_values = np.zeros((simulation_years * 252, num_simulations))\n",
        "    portfolio_values[0, :] = initial_investment\n",
        "\n",
        "    for t in range(1, simulation_years * 252):\n",
        "        portfolio_values[t, :] = portfolio_values[t - 1, :] * (1 + daily_returns[t, :])\n",
        "\n",
        "    # Calculate portfolio returns\n",
        "    portfolio_returns = (portfolio_values[-1, :] / initial_investment) - 1\n",
        "\n",
        "    # Sort portfolio returns\n",
        "    sorted_returns = np.sort(portfolio_returns)\n",
        "\n",
        "    # Calculate VaR at the desired confidence level\n",
        "    var_percentile = np.percentile(sorted_returns, (1 - confidence_level) * 100)\n",
        "\n",
        "    # Convert VaR to a dollar amount\n",
        "    var_dollar = initial_investment * var_percentile\n",
        "\n",
        "    return var_percentile, var_dollar\n",
        "\n",
        "# Example usage:\n",
        "initial_investment = 60000\n",
        "expected_return = mean_return\n",
        "volatility = std_return\n",
        "confidence_level = 0.95\n",
        "num_simulations = 10000\n",
        "simulation_years = 1\n",
        "\n",
        "var_percentile, var_dollar = monte_carlo_var(initial_investment, expected_return, volatility, confidence_level, num_simulations, simulation_years)\n",
        "print(f\"Monte Carlo VaR at {confidence_level * 100}% confidence level: {var_percentile:.4f} or ${var_dollar:.2f}\")\n",
        "\n",
        "\n",
        "\n",
        "\n",
