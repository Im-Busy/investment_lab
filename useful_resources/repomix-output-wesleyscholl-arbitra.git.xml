    steps = [
        "Verifying account balances",
        "Placing buy order on " + opportunity['buy_exchange'],
        "Confirming fill",
        "Transferring assets",
        "Placing sell order on " + opportunity['sell_exchange'],
        "Confirming execution"
    ]

    for step in steps:
        print(f"   {step}...")
        time.sleep(0.3)

