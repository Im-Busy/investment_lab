                value: String(format: "%.2f", metrics?.sharpeRatio ?? 0),
                icon: "chart.bar.xaxis",
                color: .blue
            )

            MetricCard(
                title: "Max Drawdown",
                value: String(format: "%.1f%%", metrics?.maxDrawdown ?? 0),
                icon: "arrow.down.right.circle",
                color: .red
            )

            MetricCard(
                title: "Avg Win",
                value: "$\(formatDecimal(metrics?.averageWin ?? 0))",
                icon: "arrow.up.circle.fill",
                color: .green
            )

            MetricCard(
                title: "Avg Loss",
                value: "$\(formatDecimal(metrics?.avgLoss ?? 0))",
                icon: "arrow.down.circle.fill",
                color: .red
            )

            MetricCard(
                title: "Profit Factor",
                value: String(format: "%.2f", metrics?.profitFactor ?? 0),
