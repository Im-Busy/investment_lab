    "def estimate_spot_return(spot_prices):\n",
    "    T = np.arange(len(spot_prices))\n",
    "    T = sm.add_constant(T)\n",
    "    model = sm.OLS(np.log(spot_prices), T)\n",
    "    results = model.fit()\n",
    "    return 252 * results.params[1]\n"
   ]
