   "source": [
    "# Bollinger Bands Strategy"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "GLDdf = pd.read_csv('data/GLD_history.csv', skiprows=1)\n",
    "GLDdf.columns = ['Date', 'Close', 'Volume', 'Open', 'High', 'Low']\n",
    "GLDdf['Date'] = pd.to_datetime(GLDdf['Date'], errors='coerce')\n",
    "GLDdf['Close'] = pd.to_numeric(GLDdf['Close'], errors='coerce')\n",
    "\n",
    "USOdf = pd.read_csv('data/USO_history.csv', skiprows=1)\n",
    "USOdf.columns = ['Date', 'Close', 'Volume', 'Open', 'High', 'Low']\n",
    "USOdf['Date'] = pd.to_datetime(USOdf['Date'], errors='coerce')\n",
    "USOdf['Close'] = pd.to_numeric(USOdf['Close'], errors='coerce')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Statistics & Test Signals"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "window = 20\n",
    "entryZscore = 1\n",
    "exitZscore = 0\n",
    "\n",
    "GLDdf['Ratio'] = GLDdf['Close'] / USOdf['Close']\n",
    "mean = GLDdf['Ratio'].rolling(window=window).mean()\n",
    "std = GLDdf['Ratio'].rolling(window=window).std()\n",
    "GLDdf['Z_Score'] = (GLDdf['Ratio'] - mean) / std\n",
    "\n",
    "# Entry & Exit Signals\n",
    "GLDdf['Long_Entry'] = np.where(GLDdf['Z_Score'] < -entryZscore, 1, 0)\n",
    "GLDdf['Long_Exit'] = np.where(GLDdf['Z_Score'] >= -exitZscore, 1, 0)\n",
    "GLDdf['Short_Entry'] = np.where(GLDdf['Z_Score'] > entryZscore, -1, 0)\n",
    "GLDdf['Short_Exit'] = np.where(GLDdf['Z_Score'] <= exitZscore, -1, 0)\n",
    "\n",
    "GLDdf['NumUnitsLong'] = np.nan\n",
    "GLDdf.loc[GLDdf['Long_Entry'] == 1, 'NumUnitsLong'] = 1\n",
    "GLDdf.loc[GLDdf['Long_Exit'] == 1, 'NumUnitsLong'] = 0\n",
    "GLDdf['NumUnitsLong'].ffill(inplace=True)\n",
    "\n",
    "GLDdf['NumUnitsShort'] = np.nan\n",
    "GLDdf.loc[GLDdf['Short_Entry'] == -1, 'NumUnitsShort'] = -1\n",
    "GLDdf.loc[GLDdf['Short_Exit'] == -1, 'NumUnitsShort'] = 0\n",
    "GLDdf['NumUnitsShort'].ffill(inplace=True)\n",
    "\n",
    "# Combining long and short to get net units\n",
    "GLDdf['NumUnits'] = GLDdf['NumUnitsLong'] + GLDdf['NumUnitsShort']"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Bollinger Bands Returns and Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sharpe Ratio: -0.043572958410655845\n",
      "APR: -18.65%\n"
     ]
    }
   ],
   "source": [
    "# Returns\n",
    "GLDdf['Return'] = GLDdf['Ratio'].pct_change() * GLDdf['NumUnits'].shift(1)\n",
    "GLDdf['CumulativeReturn'] = (1 + GLDdf['Return']).cumprod() - 1\n",
    "\n",
    "# Plot Cumulative Returns\n",
    "plt.plot(GLDdf['Date'], GLDdf['CumulativeReturn'])\n",
    "plt.title('Cumulative Returns of Bollinger Band Strategy on GLD/USO')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Cumulative Returns')\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# Sharpe Ratio and APR \n",
    "risk_free_rate_annual = 0.053  # 3 month t bill rate\n",
    "risk_free_rate_daily = (1 + risk_free_rate_annual) ** (1/252) - 1\n",
    "average_daily_return = GLDdf['Return'].mean()\n",
    "std_dev_return = GLDdf['Return'].std()\n",
    "sharpe_ratio = (average_daily_return - risk_free_rate_daily) / std_dev_return\n",
    "apr = (1 + average_daily_return) ** 252 - 1\n",
    "\n",
    "print(f\"Sharpe Ratio: {sharpe_ratio}\")\n",
    "print(f\"APR: {apr * 100:.2f}%\")"
   ]
  }
 ],
