        "    shares_outstanding = info.get('sharesOutstanding', 0)\n",
        "    market_cap = price * shares_outstanding\n",
        "    return market_cap\n",
        "\n",
        "def get_market_price(ticker, date):\n",
        "    stock = yf.Ticker(ticker)\n",
