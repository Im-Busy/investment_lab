#using elbow method to find optimal number of clusters

df['date']=[i for i in range(len(df.index))]

x=df[['cad','wcs','date']].reset_index(drop=True)

sse=[]
for i in range(1, 8):
    kmeans = KMeans(n_clusters = i)
    kmeans.fit(x)
